* text=auto

# Android scripts and native sources must not acquire Windows line endings.
*.sh text eol=lf
*.conf text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.md text eol=lf
*.txt text eol=lf

# These are verbatim device captures whose column formatting includes trailing spaces.
airx-raw-trace.txt -whitespace
probe-awake.txt -whitespace
probe-asleep.txt -whitespace
